{
  "name": "plotwright",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "tsx --test \"packages/*/src/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:licenses": "tsx scripts/check-licenses.ts",
    "check": "pnpm typecheck && pnpm test && pnpm check:licenses",
    "build:zones": "tsx scripts/build-zone-table.ts",
    "bench:shade": "tsx scripts/bench-shade.ts"
  },
  "devDependencies": {
    "@plotwright/core": "workspace:*",
    "@plotwright/data": "workspace:*",
    "@plotwright/providers": "workspace:*",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0"
  },
  "pnpm": {
    "overrides": {
      "expo-modules-core": "~55.0.26",
      "react": "19.2.0",
      "react-dom": "19.2.0",
      "react-native": "0.83.10"
    }
  }
}
